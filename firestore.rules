rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "admin@brilliantacademy.com" ||
        request.auth.token.email == "arshathrizvi1010@gmail.com"
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Public Collections (Visible on Homepage & Courses Page)
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /batches/{batchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /siteConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Videos and Folders
    match /videos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /folders/{folderId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Live Streaming Sessions
    match /liveSessions/{sessionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Exams and Results
    match /exams/{examId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /examResults/{resultId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Doubts and Questions
    match /doubts/{doubtId} {
      allow read, write: if isAuthenticated();
    }

    // Payment Requests
    match /paymentRequests/{paymentId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Catch-all fallback for any other authenticated documents
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
