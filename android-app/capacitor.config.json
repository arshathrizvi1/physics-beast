{
  "appId": "com.physicsbeast.app",
  "appName": "Brilliant Academy",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://brilliantacademy.vercel.app",
    "cleartext": true,
    "allowNavigation": [
      "brilliantacademy.vercel.app",
      "*.vercel.app",
      "physics-beastsl.firebaseapp.com",
      "*.firebaseapp.com",
      "accounts.google.com",
      "*.google.com",
      "*.googleapis.com",
      "*.amazonaws.com"
    ]
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": false,
      "providers": [
        "google.com"
      ]
    },
    "PrivacyScreen": {
      "enable": true
    },
    "CapacitorPasskey": {
      "origin": "https://brilliantacademy.vercel.app",
      "autoShim": true,
      "domains": [
        "brilliantacademy.vercel.app"
      ]
    }
  }
}
