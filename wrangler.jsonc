{
  "name": "physics-beast",
  "main": "worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "brillliantacademy.site/*", "zone_name": "brillliantacademy.site" },
    { "pattern": "www.brillliantacademy.site/*", "zone_name": "brillliantacademy.site" },
    { "pattern": "brillliantacademy.site/api/*", "zone_name": "brillliantacademy.site" },
    { "pattern": "www.brillliantacademy.site/api/*", "zone_name": "brillliantacademy.site" },
    { "pattern": "brillliantacademy.site/__/auth*", "zone_name": "brillliantacademy.site" },
    { "pattern": "www.brillliantacademy.site/__/auth*", "zone_name": "brillliantacademy.site" },
    { "pattern": "brillliantacademy.site/.env*", "zone_name": "brillliantacademy.site" },
    { "pattern": "www.brillliantacademy.site/.env*", "zone_name": "brillliantacademy.site" },
    { "pattern": "brillliantacademy.site/.git*", "zone_name": "brillliantacademy.site" },
    { "pattern": "www.brillliantacademy.site/.git*", "zone_name": "brillliantacademy.site" },
    { "pattern": "brillliantacademy.site/wp-admin*", "zone_name": "brillliantacademy.site" },
    { "pattern": "www.brillliantacademy.site/wp-admin*", "zone_name": "brillliantacademy.site" },
    { "pattern": "brillliantacademy.site/admin.php*", "zone_name": "brillliantacademy.site" },
    { "pattern": "www.brillliantacademy.site/admin.php*", "zone_name": "brillliantacademy.site" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brilliant-academy-db",
      "database_id": "e84fcb4f-a912-4db1-a686-3021bdb470aa"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "brilliant-videos"
    }
  ],
  "vars": {
    "FIREBASE_PROJECT_ID": "physics-beastsl",
    "SITE_URL": "https://brillliantacademy.site",
    "ENVIRONMENT": "production",
    "SECURITY_ALERT_EMAIL": "arshathrizvi1010@gmail.com"
  }
}
