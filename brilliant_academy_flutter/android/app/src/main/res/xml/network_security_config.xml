<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Zero-Trust Network Security: Disallow all cleartext HTTP traffic -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust only verified system certificates to prevent MITM interception -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Domain-specific configuration for Bunny CDN and Firebase -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">b-cdn.net</domain>
        <domain includeSubdomains="true">googleapis.com</domain>
        <domain includeSubdomains="true">firebaseio.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
